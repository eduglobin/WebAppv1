# ────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# ────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# KEEP SERVER-SIDE ONLY — never expose to frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dashboard → Project Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret

# Dashboard → Project Settings → Database → Connection string
# Use the "Transaction" pooler string for the app (port 6543)
# Format: jdbc:postgresql://aws-0-region.pooler.supabase.com:6543/postgres?user=postgres.ref&password=PASSWORD&sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?user=postgres.yourref&password=PASSWORD&sslmode=require

# ── Redis ─────────────────────────────────────────
# Upstash Dashboard → Database → REST API → Env vars
UPSTASH_REDIS_URL=rediss://your-endpoint.upstash.io:6380
UPSTASH_REDIS_PASSWORD=your-upstash-token

# Local dev Redis (Docker — used when spring.profiles.active=local)
REDIS_LOCAL_URL=redis://localhost:6379

# ── Google Maps ───────────────────────────────────
# GCP Console → Enable: Maps JavaScript API + Geocoding API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
